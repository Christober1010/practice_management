# Multi-stage build for Launchpad Spring Boot API (ECS / local Docker)
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY api/launchpad-api/pom.xml .
COPY api/launchpad-api/src ./src
RUN mvn -q -DskipTests package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/target/launchpad-api-*.jar /app/app.jar
RUN mkdir -p /data/uploads \
  && apt-get update && apt-get install -y --no-install-recommends curl \
  && rm -rf /var/lib/apt/lists/*
ENV PORT=8081
EXPOSE 8081
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD curl -sf "http://127.0.0.1:${PORT}/actuator/health" || exit 1
ENTRYPOINT ["sh", "-c", "java $JAVA_OPTS -jar /app/app.jar"]
