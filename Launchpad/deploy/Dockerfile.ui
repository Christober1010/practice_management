# Build static Next.js export and serve with nginx (S3/CloudFront alternative for ECS)
FROM node:20-alpine AS build
WORKDIR /app
COPY ui/package.json ui/pnpm-lock.yaml* ui/package-lock.json* ./
RUN if [ -f pnpm-lock.yaml ]; then corepack enable && pnpm install --frozen-lockfile; \
    elif [ -f package-lock.json ]; then npm ci; \
    else npm install; fi
COPY ui/ ./
ARG NEXT_PUBLIC_LAUNCHPAD_API_URL=http://localhost:8081
ENV NEXT_PUBLIC_LAUNCHPAD_API_URL=$NEXT_PUBLIC_LAUNCHPAD_API_URL
RUN npm run build

FROM nginx:1.27-alpine
COPY deploy/nginx-ui.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/out /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
