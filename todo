ALTER TABLE `clients`
DROP COLUMN `client_notes`;

-- staff certification table
CREATE TABLE `staff_certifications` (
  `id` BIGINT AUTO_INCREMENT PRIMARY KEY,
  `staff_id` VARCHAR(20) NOT NULL,
  `certification_type` ENUM('BCBA', 'RBT', 'BCaBA', 'Other') NOT NULL,
  `certification_number` VARCHAR(255) NOT NULL,
  `issue_date` DATE NOT NULL,
  `expiry_date` DATE NOT NULL,
  `status` ENUM('Active', 'Expired') NOT NULL DEFAULT 'Active',
  `created_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `updated_at` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  CONSTRAINT `fk_staff_certifications_staff` FOREIGN KEY (`staff_id`) REFERENCES `staff`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



-- Data migration

INSERT INTO staff_certifications (
  staff_id,
  certification_type,
  certification_number,
  issue_date,
  expiry_date
)
SELECT 
  id AS staff_id,
  staffType AS certification_type,     -- reuse staffType to guess BCBA/RBT
  certificationNumber,
  CURDATE() AS issue_date,             -- temporary placeholder
  DATE_ADD(CURDATE(), INTERVAL 1 YEAR) AS expiry_date  -- temporary placeholder
FROM staff
WHERE certificationNumber IS NOT NULL 
  AND certificationNumber <> '';
