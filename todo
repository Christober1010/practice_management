Querries ran to add client_address nd clients

<!-- For copying the address data -->
INSERT INTO client_addresses (
    client_id,
    service_location,
    address_line_1,
    address_line_2,
    city,
    state,
    zipcode,
    country
)
SELECT
    client_id,
    COALESCE(service_location, 'Home'),
    COALESCE(address_line_1, ''),
    COALESCE(address_line_2, ''),
    COALESCE(city, ''),
    COALESCE(state, ''),
    COALESCE(zipcode, ''),
    COALESCE(country, 'USA')
FROM clients
WHERE address_line_1 IS NOT NULL
   OR address_line_2 IS NOT NULL
   OR city IS NOT NULL
   OR state IS NOT NULL
   OR zipcode IS NOT NULL
   OR country IS NOT NULL;


<!-- for location -->

ALTER TABLE client_addresses
ADD COLUMN location VARCHAR(255) DEFAULT NULL AFTER service_location;

<!-- for copying location -->

UPDATE client_addresses ca
JOIN clients c ON ca.client_id = c.client_id
SET ca.location = c.location
WHERE c.location IS NOT NULL;

<!-- for assigned staff nf clients -->
<!-- -- Table for staff-to-staff assignments -->
CREATE TABLE `staff_assignments` (
  `id` INT AUTO_INCREMENT PRIMARY KEY,
  `staff_id` VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `assigned_staff_id` VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `createdAt` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `updatedAt` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  UNIQUE KEY `unique_staff_assignment` (`staff_id`, `assigned_staff_id`),
  FOREIGN KEY (`staff_id`) REFERENCES `staff`(`id`) ON DELETE CASCADE,
  FOREIGN KEY (`assigned_staff_id`) REFERENCES `staff`(`id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;

<!-- -- Table for staff-to-client assignments -->
CREATE TABLE `staff_client_assignments` (
  `id` INT AUTO_INCREMENT PRIMARY KEY,
  `staff_id` VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `client_id` VARCHAR(36) CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci NOT NULL,
  `createdAt` TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
  `updatedAt` TIMESTAMP DEFAULT CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP,
  UNIQUE KEY `unique_staff_client_assignment` (`staff_id`, `client_id`),
  FOREIGN KEY (`staff_id`) REFERENCES `staff`(`id`) ON DELETE CASCADE,
  FOREIGN KEY (`client_id`) REFERENCES `clients`(`client_id`) ON DELETE CASCADE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_general_ci;



<!-- -- Migrate assignedStaff data -->
INSERT INTO staff_assignments (staff_id, assigned_staff_id)
SELECT 
    s.id,
    jt.assigned_staff_id
FROM staff s
CROSS JOIN JSON_TABLE(
    s.assignedStaff,
    '$[*]' COLUMNS (assigned_staff_id VARCHAR(20) PATH '$')
) AS jt
WHERE s.assignedStaff IS NOT NULL 
  AND JSON_LENGTH(s.assignedStaff) > 0
ON DUPLICATE KEY UPDATE updatedAt = CURRENT_TIMESTAMP;

<!-- -- Migrate assignedClients data -->
INSERT INTO staff_client_assignments (staff_id, client_id)
SELECT 
    s.id,
    jt.client_id
FROM staff s
CROSS JOIN JSON_TABLE(
    s.assignedClients,
    '$[*]' COLUMNS (client_id VARCHAR(36) PATH '$')
) AS jt
WHERE s.assignedClients IS NOT NULL 
  AND JSON_LENGTH(s.assignedClients) > 0
ON DUPLICATE KEY UPDATE updatedAt = CURRENT_TIMESTAMP;

<!-- -- After migration is complete and verified, you can remove the JSON columns
-- ALTER TABLE staff DROP COLUMN assignedStaff;
