# Backend environment variables for Mahaverse
# Copy this file to `backend/.env` and replace with real values.
# IMPORTANT: Never commit `backend/.env` (it's gitignored).

# -----------------------------
# Google Drive integration (OAuth Mode - Same as Launchpad)
# -----------------------------
GOOGLE_DRIVE_ENABLED=true
GOOGLE_DRIVE_AUTH_MODE=oauth

# OAuth Client Credentials (can reuse same as launchpad or create new)
GOOGLE_DRIVE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET

# OAuth Redirect URI (update with your Mahaverse domain)
# Note: You'll need to add this URI to your Google OAuth consent screen
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://www.mahabehavioralhealth.com/mahaverse-backend-logics/drive_oauth_callback.php

# Root folder ID in Drive (folder where client folders will be created)
# Get this from your Google Drive folder URL: https://drive.google.com/drive/folders/FOLDER_ID_HERE
# This should be a different folder than launchpad, or same if you want everything in one place
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_DRIVE_FOLDER_ID

# Optional: Shared Drive ID (if using Shared Drives)
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Optional: override scopes (comma-separated)
# Default: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# Encryption key for OAuth refresh token (base64 encoded 32 bytes)
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Can reuse same key as launchpad or generate new one
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Encryption key for sensitive data (SSN, etc.) - base64 encoded 32 bytes
# Generate with: python3 -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# Can reuse same key as launchpad or generate new one
SSN_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTES

# Workspace user to impersonate (for service account mode - not used in OAuth mode)
# Keep this if you might switch to service account mode later
GOOGLE_DRIVE_IMPERSONATE_USER=appsvc@mahabehavioralhealth.com

# -----------------------------
# Email Configuration (Optional - for sending emails)
# -----------------------------
MAIL_TRANSPORT=smtp
MAIL_FROM=noreply@mahabehavioralhealth.com
MAIL_FROM_NAME="Maha Behavioral Health"
SMTP_HOST=smtp.ionos.com
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=noreply@mahabehavioralhealth.com
SMTP_PASS=

# -----------------------------
# Availity EDI / SFTP (batch 837 upload)
# -----------------------------
AVAILITY_ENABLED=false
AVAILITY_ENV=production
AVAILITY_SFTP_HOST=files.availity.com
AVAILITY_SFTP_PORT=22
AVAILITY_SFTP_USER=YOUR_EDI_USERNAME
AVAILITY_SFTP_PASSWORD=YOUR_EDI_PASSWORD
AVAILITY_SFTP_REMOTE_DIR=Send
AVAILITY_ISA_SENDER_ID=YOUR_ISA02_ID
AVAILITY_ISA_PASSWORD=YOUR_ISA04_PASSWORD
AVAILITY_GS_SENDER_CODE=YOUR_GS02_CODE
AVAILITY_SUBMITTER_NAME=MAHA BEHAVIORAL HEALTH
AVAILITY_RECEIVER_ID=030240928
AVAILITY_USAGE_INDICATOR=P
AVAILITY_FILE_PREFIX=837P

# -----------------------------
# Office Ally EDI / SFTP (batch 837P upload)
# -----------------------------
# Admin fills SFTP mailbox credentials from Office Ally Support (support@officeally.com).
OFFICEALLY_ENABLED=false
OFFICEALLY_ENV=production
OFFICEALLY_SFTP_HOST=ftp10.officeally.com
OFFICEALLY_SFTP_PORT=22
OFFICEALLY_SFTP_USER=YOUR_OFFICEALLY_SFTP_USERNAME
OFFICEALLY_SFTP_PASSWORD=YOUR_OFFICEALLY_SFTP_PASSWORD
OFFICEALLY_SFTP_REMOTE_DIR=inbound
OFFICEALLY_SFTP_REPORTS_DIR=outbound
OFFICEALLY_ISA_SENDER_ID=YOUR_TAX_ID
OFFICEALLY_ISA_SENDER_QUALIFIER=ZZ
OFFICEALLY_ISA_RECEIVER_QUALIFIER=ZZ
OFFICEALLY_GS_SENDER_CODE=YOUR_TAX_ID
OFFICEALLY_GS_RECEIVER_CODE=OA
OFFICEALLY_SUBMITTER_NAME=MAHA BEHAVIORAL HEALTH
OFFICEALLY_RECEIVER_ID=330897513
OFFICEALLY_RECEIVER_NAME=OFFICE ALLY
OFFICEALLY_FILE_PREFIX=837P

