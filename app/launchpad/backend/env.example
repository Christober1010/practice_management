# Backend environment variables (DUMMY VALUES)
# Copy this file to `backend/.env` and replace with real values.
# IMPORTANT: Never commit `backend/.env` (it's gitignored).

# -----------------------------
# Google Drive integration
# -----------------------------
GOOGLE_DRIVE_ENABLED=false

# Auth mode: service_account (recommended) OR oauth
GOOGLE_DRIVE_AUTH_MODE=service_account

# Root folder ID in Drive (folder where staff_<id> folders will be created)
GOOGLE_DRIVE_ROOT_FOLDER_ID=YOUR_ROOT_FOLDER_ID_HERE

# Folder ID (under the same parent/root) where signed offer letters should be stored.
# If unset, the backend will create/find a folder named "signed_offer_letters" under GOOGLE_DRIVE_ROOT_FOLDER_ID.
GOOGLE_DRIVE_SIGNED_OFFERS_FOLDER_ID=

# Parent folder for per-client intake subfolders (client_intake_{id}_{name}/).
# Must be a folder the Launchpad OAuth Google account can access (same as offer letters).
# Example: app_offerletter under maha_app_launchpad (GOOGLE_DRIVE_SIGNED_OFFERS_FOLDER_ID).
# If unset, falls back to GOOGLE_DRIVE_SIGNED_OFFERS_FOLDER_ID, then GOOGLE_DRIVE_ROOT_FOLDER_ID.
GOOGLE_DRIVE_CLIENT_INTAKE_FOLDER_ID=

# Optional: Shared Drive ID (if using Shared Drives)
GOOGLE_DRIVE_SHARED_DRIVE_ID=

# Optional: override scopes (comma-separated)
# - Service account default in this repo is: https://www.googleapis.com/auth/drive
# - OAuth default in this repo is: https://www.googleapis.com/auth/drive.file
GOOGLE_DRIVE_SCOPES=https://www.googleapis.com/auth/drive.file

# -----------------------------
# Option A: Service Account + Domain-Wide Delegation
# -----------------------------
# Workspace user to impersonate
GOOGLE_DRIVE_IMPERSONATE_USER=hr-automation@yourdomain.com

# Path to service account JSON (recommended)
GOOGLE_SERVICE_ACCOUNT_JSON=/secure/path/to/service-account.json

# Inline JSON (NOT recommended)
# GOOGLE_SERVICE_ACCOUNT_JSON_INLINE={"type":"service_account",...}

# -----------------------------
# Option B: OAuth “Connect Drive”
# -----------------------------
GOOGLE_DRIVE_OAUTH_CLIENT_ID=YOUR_CLIENT_ID.apps.googleusercontent.com
GOOGLE_DRIVE_OAUTH_CLIENT_SECRET=YOUR_CLIENT_SECRET
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=https://launchpad.mahabehavioralhealth.com/backend/drive_oauth_callback.php

# base64(32 random bytes) for encrypting refresh token at rest in DB
# Example generation:
#   python - <<'PY'
#   import os,base64; print(base64.b64encode(os.urandom(32)).decode())
#   PY
GOOGLE_DRIVE_TOKEN_ENCRYPTION_KEY=BASE64_32_BYTE_KEY_HERE

# base64(32 random bytes) for encrypting SSNs at rest in DB
SSN_ENCRYPTION_KEY=BASE64_32_BYTE_KEY_HERE

# Shared secret for Mahaverse → Launchpad SSO (sso_login.php).
# Must match NEXT_PUBLIC_LAUNCHPAD_SSO_SECRET in the Mahaverse frontend build (optional but recommended).
# LAUNCHPAD_SSO_SECRET=your-long-random-secret

