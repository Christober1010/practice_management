# Forward Authorization to PHP (many shared hosts drop it otherwise; token auth breaks).
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP:Authorization} .
RewriteRule ^ - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]
</IfModule>

# Block direct HTTP access to includes (not API entrypoints).
<IfModule mod_authz_core.c>
  <FilesMatch "^(config|db|rbac_helpers|behavior_helpers|client_auth_units_helpers|drive_helper|claims_billing_lib|session_rate_lib|availity_config_helper|availity_sftp_helper|availity_edi837_builder)\.php$">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^(config|db|rbac_helpers|behavior_helpers|client_auth_units_helpers|drive_helper|claims_billing_lib|session_rate_lib|availity_config_helper|availity_sftp_helper|availity_edi837_builder)\.php$">
    Order deny,allow
    Deny from all
  </FilesMatch>
</IfModule>
